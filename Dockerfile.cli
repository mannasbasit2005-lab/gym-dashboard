# ---- Gym Management System: original C console program, in a container ----
FROM gcc:13 AS build
WORKDIR /src
COPY cli/gym_management_system.c .
RUN gcc -std=c99 -O2 -Wall -Wextra -o gym gym_management_system.c

FROM debian:bookworm-slim
ENV TZ=Asia/Karachi
RUN apt-get update \
 && apt-get install -y --no-install-recommends tzdata \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --uid 1000 --create-home app \
 && mkdir /data && chown 1000:1000 /data
COPY --from=build /src/gym /usr/local/bin/gym
USER 1000
# The C program reads/writes members.txt and attendance.txt in the working directory
WORKDIR /data
CMD ["gym"]
